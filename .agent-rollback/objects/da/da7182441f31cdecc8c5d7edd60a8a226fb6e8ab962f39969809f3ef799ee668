def test_invalid_judge_result_invalidates_evaluation_and_first_ratchet(minimal_registry):
    execution = ScriptedLLM(["bare", "skill"])
    judge = ScriptedLLM(["", _judge_json("B_better"), _judge_json("A_better")])
    evaluator = SkillEvaluator(minimal_registry, execution, judge)
    result = evaluator.evaluate_skill(
        "test_skill",
        cases=[{"id": "c1", "query": "q", "reference": "r"}],
        p0_ids=["c1"],
    )
    assert len(execution.calls) == 2
    assert len(judge.calls) == 3
    assert all(call[0]["role"] == "system" for call in judge.calls)
    assert result.valid is False
    assert result.p0_pass is False
    assert result.effect_score["task"] == 0.0
    assert check_ratchet(None, result).decision == "DECLINED"
    with pytest.raises(ValueError, match="INVALID"):
        SkillEvaluator._dim_score([("c1", "INVALID")], 25.0)

    valid = result
    valid.valid = True
    valid.invalid_reasons = []
    invalid_old = type(result)(
        release_id="old",
        structure_score=dict(valid.structure_score),
        effect_score=dict(valid.effect_score),
        objective_metrics={},
        p0_pass=False,
        valid=False,
        invalid_reasons=["old judge invalid"],
    )
    assert check_ratchet(invalid_old, valid).decision == "DECLINED"


def test_rejudge_frozen_records_balance_hashes_and_canonical_verdicts():
    module = _load_rejudge_module()
    source = Path(__file__).resolve().parents[1] / "runs" / "blind_eval_samples.json"
    source_bytes = source.read_bytes()
    data = json.loads(source_bytes)
    # Exact tied is an explicit valid decision for all non-sentinel comparisons.
    llm = ScriptedLLM([_judge_json("tied")] * 63)
    result = module.rejudge_data(
        data,
        PairwiseJudge(llm),
        source_bytes=source_bytes,
        judge_config={"model": "fake", "base_url": "offline", "temperature": 0},
    )
    assert source.read_bytes() == source_bytes
    assert result["meta"]["invalid_count"] == 0
    assert result["meta"]["truth_sentinel_candidate_A_better"] == 0
    for counts in result["meta"]["presented_counts"].values():
        assert sorted(counts.values()) == [10, 11]
    for sample in result["samples"]:
        assert sample["previous_judge_verdicts"]
        assert set(sample["output_sha256"]) == {"skill", "baseline"}
        for audit in sample["judge_audit"].values():
            assert audit["canonical_verdict"] in {"A_better", "tied", "B_better"}
            assert audit["presented_order"]["A"] in {"skill", "baseline"}
