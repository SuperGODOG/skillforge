def test_skill_evaluator_current_body_cache():
    cache = EvaluatorOutputCache()
    llm_exec = MockLLM(["skill_out_v1", "skill_out_v2"], token_per_call=60)
    llm_judge = MockLLM([], token_per_call=60)

    evaluator = SkillEvaluator(
        registry=object(),
        llm=llm_exec,
        judge_llm=llm_judge,
        output_cache=cache,
    )

    body_v1 = "## Overview\nversion 1"
    body_v2 = "## Overview\nversion 2"

    # 首次执行 body_v1
    res1, _ = evaluator._run_with_skill("query", body_v1)
    assert res1 == "skill_out_v1"
    assert len(llm_exec.calls) == 1

    # 再次执行相同 query + 相同 body_v1：命中缓存
    res1_cached, _ = evaluator._run_with_skill("query", body_v1)
    assert res1_cached == "skill_out_v1"
    assert len(llm_exec.calls) == 1, "同 query 同 body 必须命中缓存"

    # 执行相同 query + 不同 body_v2：未命中缓存
    res2, _ = evaluator._run_with_skill("query", body_v2)
    assert res2 == "skill_out_v2"
    assert len(llm_exec.calls) == 2, "body 变更必须重新生成"


