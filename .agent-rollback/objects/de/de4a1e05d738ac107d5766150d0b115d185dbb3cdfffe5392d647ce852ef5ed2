# 1. 统一 LLM Ledger 记账与多角色追踪
# ============================================================================


def test_ledger_tracks_all_roles_calls_and_tokens():
    budget = EvolveBudget(max_calls=10, max_tokens=1000)
    ledger = LLMLedger(budget=budget)

    agent_llm = MockLLM(["agent response 1", "agent response 2"], token_per_call=80)
    judge_llm = MockLLM(["judge response 1"], token_per_call=120)
    evolver_llm = MockLLM(["evolver response 1"], token_per_call=200)

    tracked_agent = wrap_with_ledger(agent_llm, ledger, role="agent")
    tracked_judge = wrap_with_ledger(judge_llm, ledger, role="judge")
    tracked_evolver = wrap_with_ledger(evolver_llm, ledger, role="evolver")

    tracked_agent.invoke([{"role": "user", "content": "hello"}])
    tracked_agent.invoke([{"role": "user", "content": "world"}])
    tracked_judge.invoke([{"role": "user", "content": "evaluate"}])
    tracked_evolver.invoke([{"role": "user", "content": "patch"}])

    assert ledger.total_calls == 4
    assert ledger.total_tokens == 80 + 80 + 120 + 200
    assert ledger.prompt_tokens == int((80 + 80 + 120 + 200) * 0.6)
    assert ledger.completion_tokens == int((80 + 80 + 120 + 200) * 0.4)

    assert ledger.calls_by_role == {"agent": 2, "judge": 1, "evolver": 1}
    assert ledger.tokens_by_role == {"agent": 160, "judge": 120, "evolver": 200}
    assert len(ledger.records) == 4
    assert all(isinstance(r, LLMCallRecord) for r in ledger.records)


