class MockLLM:
    """Deterministic mock LLM providing responses and configurable usage."""

    def __init__(self, contents: list[str], token_per_call: int = 100, model: str = "test-model"):
        self.contents = list(contents)
        self.token_per_call = token_per_call
        self.model = model
        self.calls: list[dict] = []

    def invoke(self, messages, **kwargs):
        self.calls.append({"messages": messages, "kwargs": kwargs})
        c = self.contents.pop(0) if self.contents else ""
        return SimpleNamespace(
            content=c,
            usage={
                "prompt_tokens": int(self.token_per_call * 0.6),
                "completion_tokens": int(self.token_per_call * 0.4),
                "total_tokens": self.token_per_call,
            },
        )


def _mk_meta(name: str = "test_skill") -> SkillMeta:
    return SkillMeta(
        name=name,
        version="1.0.0",
        description="测试 Skill 说明",
        use_when="测试场景",
        not_for=["其他场景"],
        dependencies=[],
        trigger=Trigger(keywords=["test", "skill"]),
        examples=["ex1"],
    )


