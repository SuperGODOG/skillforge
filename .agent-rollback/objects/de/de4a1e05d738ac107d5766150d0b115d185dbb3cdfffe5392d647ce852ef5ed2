def test_build_llm_pair_attaches_ledger(monkeypatch):
    from skillforge.evaluator.llm_factory import build_llm_pair

    class FakeClient:
        def __init__(self, **kwargs):
            self.kwargs = kwargs

        def invoke(self, messages, **kw):
            return SimpleNamespace(content="ok", usage={"total_tokens": 50})

    monkeypatch.setattr("hello_agents.HelloAgentsLLM", FakeClient)
    values = {
        "LLM_API_KEY": "k1",
        "LLM_MODEL_ID": "m1",
        "LLM_BASE_URL": "http://u1",
        "JUDGE_LLM_API_KEY": "k2",
        "JUDGE_LLM_MODEL_ID": "m2",
        "JUDGE_LLM_BASE_URL": "http://u2",
    }
    for k, v in values.items():
        monkeypatch.setenv(k, v)

    ledger = LLMLedger()
    exec_llm, judge_llm = build_llm_pair(ledger=ledger)

    assert isinstance(exec_llm, TrackedLLM)
    assert isinstance(judge_llm, TrackedLLM)
    assert exec_llm.ledger is ledger
    assert judge_llm.ledger is ledger

    exec_llm.invoke([{"role": "user", "content": "hi"}])
    judge_llm.invoke([{"role": "user", "content": "hi"}])

    assert ledger.total_calls == 2
    assert ledger.calls_by_role == {"agent": 1, "judge": 1}
