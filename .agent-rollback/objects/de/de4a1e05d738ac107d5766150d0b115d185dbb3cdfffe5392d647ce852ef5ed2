def test_evaluator_output_cache_hits_and_misses():
    cache = EvaluatorOutputCache()
    fp1 = "fingerprint-alpha"
    fp2 = "fingerprint-beta"

    # 首次查询，未命中
    assert cache.get_bare("query-1", fp1) is None
    assert cache.misses == 1

    # 写入缓存
    cache.set_bare("query-1", fp1, "output-alpha", {"tokens": 42})
    assert len(cache) == 1

    # 再次查询相同 query + 相同指纹：命中
    hit = cache.get_bare("query-1", fp1)
    assert hit is not None
    assert hit[0] == "output-alpha"
    assert hit[1]["tokens"] == 42
    assert cache.hits == 1

    # 相同 query + 不同指纹（例如 Judge 或执行配置改变）：未命中！防陈旧命中
    assert cache.get_bare("query-1", fp2) is None
    assert cache.misses == 2


def test_fingerprint_changes_on_judge_and_execution_config():
    llm_exec_1 = MockLLM([], model="exec-v1")
    llm_exec_2 = MockLLM([], model="exec-v2")
    llm_judge_1 = MockLLM([], model="judge-v1")
    llm_judge_2 = MockLLM([], model="judge-v2")

    fp_base = compute_evaluator_fingerprint(llm_exec_1, llm_judge_1)
    fp_diff_judge = compute_evaluator_fingerprint(llm_exec_1, llm_judge_2)
    fp_diff_exec = compute_evaluator_fingerprint(llm_exec_2, llm_judge_1)

    assert fp_base != fp_diff_judge, "Judge 配置变化必须生成不同指纹，防陈旧缓存命中"
    assert fp_base != fp_diff_exec, "Execution 配置变化必须生成不同指纹"
    assert fp_base == compute_evaluator_fingerprint(llm_exec_1, llm_judge_1), "相同配置指纹必须完全稳定"


def test_skill_evaluator_bare_output_uses_cache():
    cache = EvaluatorOutputCache()
    llm_exec = MockLLM(["exec_bare_result", "exec_skill_result"], token_per_call=50, model="exec-m")
    llm_judge = MockLLM(["judge_result"], token_per_call=50, model="judge-m")

    evaluator = SkillEvaluator(
        registry=object(),
        llm=llm_exec,
        judge_llm=llm_judge,
        output_cache=cache,
    )

    # 第一次 _run_bare
    content1, m1 = evaluator._run_bare("what is the weather?")
    assert content1 == "exec_bare_result"
    assert len(llm_exec.calls) == 1
    assert cache.hits == 0
    assert cache.misses == 1

    # 第二次 _run_bare 相同 query：走缓存，不产生新 LLM 调用，彻底消除随机基线漂移！
    content2, m2 = evaluator._run_bare("what is the weather?")
    assert content2 == "exec_bare_result"
    assert len(llm_exec.calls) == 1, "命中缓存不得调用 LLM"
    assert cache.hits == 1


