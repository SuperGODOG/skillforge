def test_candidate_clamp_truncation():
    meta = _mk_meta()
    valid_md = "---\nname: test_skill\nversion: 1.0.1\ndescription: X\nuse_when: Y\ntrigger:\n  keywords: [a]\n---\n\n## Overview\n..."
    llm = MockLLM([json.dumps([
        {"level": "L1", "rationale": "p1", "new_skill_md": valid_md},
        {"level": "L1", "rationale": "p2", "new_skill_md": valid_md},
        {"level": "L1", "rationale": "p3", "new_skill_md": valid_md},
        {"level": "L1", "rationale": "p4", "new_skill_md": valid_md},
    ])])

    # 设定 clamp_limit 为 2，截断模式
    patches = _generate_patches(
        llm, meta, "body", [], [],
        max_candidates=4,
        clamp_limit=2,
        on_candidate_overflow="truncate",
    )
    assert len(patches) == 2, "超 clamp 必须截断为 2，不能静默保留 4 个"


def test_candidate_clamp_rejection():
    meta = _mk_meta()
    valid_md = "---\nname: test_skill\nversion: 1.0.1\ndescription: X\nuse_when: Y\ntrigger:\n  keywords: [a]\n---\n\n## Overview\n..."
    llm = MockLLM([json.dumps([
        {"level": "L1", "rationale": "p1", "new_skill_md": valid_md},
        {"level": "L1", "rationale": "p2", "new_skill_md": valid_md},
        {"level": "L1", "rationale": "p3", "new_skill_md": valid_md},
    ])])

    # 设定 clamp_limit 为 2，拒绝模式
    with pytest.raises(BudgetExceededError) as exc_info:
        _generate_patches(
            llm, meta, "body", [], [],
            max_candidates=3,
            clamp_limit=2,
            on_candidate_overflow="reject",
        )

    assert exc_info.value.cap_type == "candidate"
    assert "CANDIDATE_LIMIT_EXCEEDED" in exc_info.value.reason


