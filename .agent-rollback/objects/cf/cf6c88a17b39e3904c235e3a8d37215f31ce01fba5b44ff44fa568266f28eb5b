def test_evaluate_p0_gate_task_completion_b_better_fails():
    """场景 6: 正常执行完成，但核心任务表现不如基线 (B_better)，判为 P0 FAIL"""
    mock_evaluator = MagicMock()
    mock_eval_res = MagicMock()
    mock_eval_res.valid = True
    mock_eval_res.invalid_reasons = []
    mock_eval_res.case_verdicts = [
        {"case_id": "wq_d01", "task_completion": "B_better"},
    ]
    mock_evaluator.evaluate_skill.return_value = mock_eval_res

    custom_cases = [
        {"id": "wq_d01", "skill": "weather_query", "query": "q1", "reference": "r1"},
    ]

    res = evaluate_p0_gate(mock_evaluator, "weather_query", p0_cases=custom_cases)
    assert res.valid is True
    assert res.p0_pass is False
    assert any("B_better" in r for r in res.failure_reasons)

    verdict = check_p0_ratchet_verdict(res)
    assert verdict.decision == "DECLINED"
    assert any("未通过" in r for r in verdict.reasons)


def test_check_p0_ratchet_verdict_unexecuted_is_declined():
    """验证未执行 P0 (None) 时拒绝发布"""
    verdict = check_p0_ratchet_verdict(None)
    assert verdict.decision == "DECLINED"
    assert any("未执行" in r for r in verdict.reasons)


def test_merge_p0_into_eval_result():
    """验证将 P0 独立结果合并到 EvalResult"""
    eval_res = EvalResult(
        release_id="candidate-1",
        structure_score={},
        effect_score={},
        objective_metrics={},
        p0_pass=True,
        valid=True,
    )

    invalid_p0 = P0GateResult(
        valid=False,
        p0_pass=False,
        executed_count=0,
        expected_count=2,
        invalid_reasons=["P0 用例执行不完整"],
    )
    merged = merge_p0_into_eval_result(eval_res, invalid_p0)
    assert merged.valid is False
    assert merged.p0_pass is False
    assert "P0 用例执行不完整" in merged.invalid_reasons
