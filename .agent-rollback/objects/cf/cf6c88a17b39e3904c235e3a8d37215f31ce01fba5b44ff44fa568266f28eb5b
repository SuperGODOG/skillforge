"""
测试独立 P0 门控机制与失效路径拦截 (P0-D P0 Gate Tests)
"""

from pathlib import Path
from unittest.mock import MagicMock
import pytest

from skillforge.evaluator.p0_gate import (
    P0EmptyCasesError,
    P0GateResult,
    P0LoadError,
    check_p0_ratchet_verdict,
    evaluate_p0_gate,
    load_p0_cases,
    merge_p0_into_eval_result,
)
from skillforge.models import EvalResult

REPO_ROOT = Path(__file__).resolve().parent.parent


def test_load_p0_cases_success():
    """验证从仓库独立加载各 skill 的 P0 用例"""
    wq_cases = load_p0_cases(REPO_ROOT, skill_name="weather_query")
    assert len(wq_cases) == 4
    assert {c["id"] for c in wq_cases} == {"wq_d01", "wq_d05", "wq_d07", "wq_d10"}

    wr_cases = load_p0_cases(REPO_ROOT, skill_name="write_weekly_report")
    assert len(wr_cases) == 3
    assert {c["id"] for c in wr_cases} == {"wr_d01", "wr_d03", "wr_d04"}

    er_cases = load_p0_cases(REPO_ROOT, skill_name="explain_regex")
    assert len(er_cases) == 3
    assert {c["id"] for c in er_cases} == {"er_d01", "er_d02", "er_d04"}


def test_load_p0_cases_unknown_skill_raises():
    """验证不存在或未配置 P0 的技能抛出 P0EmptyCasesError"""
    with pytest.raises(P0EmptyCasesError):
        load_p0_cases(REPO_ROOT, skill_name="non_existent_skill")


def test_load_p0_cases_missing_file_raises(tmp_path):
    """验证缺失 p0_cases.json 时抛出 P0LoadError"""
    with pytest.raises(P0LoadError):
        load_p0_cases(tmp_path, skill_name="weather_query")


def test_evaluate_p0_gate_all_pass():
    """场景 1: P0 用例全部通过 task_completion 检验"""
    mock_evaluator = MagicMock()
    mock_eval_res = MagicMock()
    mock_eval_res.valid = True
    mock_eval_res.invalid_reasons = []
    mock_eval_res.case_verdicts = [
        {"case_id": "wq_d01", "task_completion": "A_better"},
        {"case_id": "wq_d05", "task_completion": "tied"},
    ]
    mock_evaluator.evaluate_skill.return_value = mock_eval_res

    custom_cases = [
        {"id": "wq_d01", "skill": "weather_query", "query": "q1", "reference": "r1"},
        {"id": "wq_d05", "skill": "weather_query", "query": "q5", "reference": "r5"},
    ]

    res = evaluate_p0_gate(mock_evaluator, "weather_query", p0_cases=custom_cases)
    assert res.valid is True
    assert res.p0_pass is True
    assert res.executed_count == 2
    assert res.expected_count == 2
    assert len(res.invalid_reasons) == 0
    assert len(res.failure_reasons) == 0

    verdict = check_p0_ratchet_verdict(res)
    assert verdict.decision == "PASS"


def test_evaluate_p0_gate_empty_cases_invalid():
    """场景 2 (失效路径): 空用例集判为 INVALID"""
    mock_evaluator = MagicMock()
    res = evaluate_p0_gate(mock_evaluator, "weather_query", p0_cases=[])
    assert res.valid is False
    assert res.p0_pass is False
    assert any("为空" in r for r in res.invalid_reasons)

    verdict = check_p0_ratchet_verdict(res)
    assert verdict.decision == "DECLINED"
    assert any("INVALID" in r for r in verdict.reasons)


def test_evaluate_p0_gate_infrastructure_exception_invalid():
    """场景 3 (失效路径): 基础设施崩溃 (如 LLM / 网络 / 工具抛异常) 判为 INVALID"""
    mock_evaluator = MagicMock()
    mock_evaluator.evaluate_skill.side_effect = RuntimeError("Remote LLM Connection Timeout")

    custom_cases = [
        {"id": "wq_d01", "skill": "weather_query", "query": "q1", "reference": "r1"},
    ]

    res = evaluate_p0_gate(mock_evaluator, "weather_query", p0_cases=custom_cases)
    assert res.valid is False
    assert res.p0_pass is False
    assert any("基础设施异常" in r for r in res.invalid_reasons)

    verdict = check_p0_ratchet_verdict(res)
    assert verdict.decision == "DECLINED"


