def test_acceptance_6a_er_h02_localization_and_branch():
    """验收 6(a):
    1. 定位 er_h02 在 evaluation_sets 数据中的层级（确定在 repair 层，且不在 holdout/audit 层，数据只读）
    2. er_h02 与各 bundle 走对正确分支
    """
    repair_data = load_json_dataset(EVAL_DIR / "repair_set.json")
    holdout_data = load_json_dataset(EVAL_DIR / "experiment_holdout.json")
    audit_data = load_json_dataset(EVAL_DIR / "final_audit.json")

    repair_cases = {c["id"]: c for c in repair_data["cases"]}
    holdout_ids = {c["id"] for c in holdout_data["cases"]}
    audit_ids = {c["id"] for c in audit_data["cases"]}

    # 断言定位：er_h02 严格位于 repair 层
    assert "er_h02" in repair_cases, "er_h02 必须存在于 repair_set.json (repair 层)"
    assert "er_h02" not in holdout_ids, "er_h02 严禁泄漏到 holdout 层"
    assert "er_h02" not in audit_ids, "er_h02 严禁泄漏到 audit 层"

    er_case = repair_cases["er_h02"]
    assert er_case["skill"] == "explain_regex"
    assert er_case["query"] == "讲讲 \\1 反向引用"

    # 构造 er_h02 失败样本，走增强根因分析
    fails = [
        Failure(
            case_id="er_h02",
            query=er_case["query"],
            reference=er_case["reference"],
            output_skill="\\1 就是第一个组",
            output_baseline="反向引用 \\1 用于匹配与前面第 1 个括号捕获的内容相同的字符串...",
            losing_dims=["task_completion", "readability"],
        )
    ]
    meta = _create_mock_meta("explain_regex")
    body = REPO_ROOT.joinpath("skills", "explain_regex", "SKILL.md").read_text(encoding="utf-8")
    route_trace = {
        "hit_layer": "rule",
        "declared_level": "L1",
        "computed_level": "L1",
        "verdict": "ROUTE_MATCH",
        "trigger_keywords": meta.trigger.keywords,
        "use_when": meta.use_when,
    }
    tool_trace = {"failed_phase": "none", "failure_type": "NONE", "is_dependency_failure": False}

    llm = CapturingFakeLLM([
        json.dumps({
            "prompt_vague": {"prob": 0.8, "why": "Instructions 未说明反向引用与小例子步骤"},
            "trigger_inaccurate": {"prob": 0.1, "why": ""},
            "deps_broken": {"prob": 0.0, "why": ""},
            "boundary_missing": {"prob": 0.1, "why": ""},
            "eval_noise": {"prob": 0.0, "why": ""},
        })
    ])

    causes = _analyze_root_cause(
        llm, meta, body, fails,
        relevant_body_sections=extract_relevant_body_sections(body),
        route_trace=route_trace,
        tool_trace=tool_trace,
    )
    assert len(causes) > 0
    assert causes[0].label == "prompt_vague"
    # 验证走对分支：不是 dependency，可进入后续 patch 生成
    is_dep, _ = is_dependency_issue(causes, tool_trace)
    assert is_dep is False


def test_acceptance_6b_dependency_failure_generates_no_patch_and_outputs_review(tmp_path: Path):
    """验收 6(b):
    构造 dependency 类失败（如外部工具 503 超时/缺失）→
    断言不产出文案 patch（patches_generated == 0，无任何 prompt 提案），
    直接输出 REVIEW 诊断归档！
    """
    # 初始化受测环境
    skills_dir = tmp_path / "skills" / "weather_query"
    skills_dir.mkdir(parents=True, exist_ok=True)
    skill_content = """---
name: weather_query
version: 1.0.0
description: 查询天气
use_when: 查询天气
not_for: []
dependencies:
  - amap_weather_api
trigger:
  keywords:
    - 天气
examples:
  - 北京天气
evaluation:
  last_score: null
  last_release_id: null
