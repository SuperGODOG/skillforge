def test_candidate_budget_round_and_total_semantics():
    """验证 models.py 的 max_candidates_first_round/retry/total 字段语义与 evolver clamp 行为。"""
    # 1. 预算模型首轮/反思轮/累计计算
    b1 = EvolveBudget(max_candidates_first_round=2, max_candidates_retry=1, max_candidates_total=3)
    assert b1.get_effective_candidate_limit(round_index=0, candidates_so_far=0) == 2
    assert b1.get_effective_candidate_limit(round_index=1, candidates_so_far=2) == 1
    assert b1.get_effective_candidate_limit(round_index=2, candidates_so_far=3) == 0

    # 2. 累计上限优先截断首轮
    b2 = EvolveBudget(max_candidates_first_round=5, max_candidates_total=2)
    assert b2.get_effective_candidate_limit(round_index=0, candidates_so_far=0) == 2

    # 3. 别名与默认值同步
    b3 = EvolveBudget(max_candidates_first_round=4)
    assert b3.max_candidates == 4

    b4 = EvolveBudget(max_candidates=5)
    assert b4.max_candidates_first_round == 5

    # 4. 在 evolver.evolve_full 中生效：first_round 超限 reject
    reg = SimpleNamespace(repo_root=Path("."))
    evaluator_mock = SimpleNamespace()
    evolver = SkillEvolver(
        registry=reg,
        evaluator=evaluator_mock,
        llm=SimpleNamespace(model="mock-m", invoke=lambda *a, **k: None),
        budget=EvolveBudget(max_candidates_first_round=1, on_candidate_overflow="reject"),
    )
    outcome = evolver.evolve_full("test_skill", max_candidates=3, verbose=False)
    assert outcome.error is not None
    assert "CANDIDATE_LIMIT_EXCEEDED" in outcome.error
    assert "requested 3 candidates > clamp 1" in outcome.error

