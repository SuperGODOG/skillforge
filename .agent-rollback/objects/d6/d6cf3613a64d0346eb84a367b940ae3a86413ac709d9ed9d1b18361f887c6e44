def test_fingerprint_changes_on_judge_template_and_semantic_invalidation(monkeypatch):
    """验证 config_fingerprint 纳入 Judge 模板、system prompt、维度提示与解析契约，
    修改后指纹改变且原有缓存无法命中。"""
    import skillforge.evaluator.judge as judge_mod

    exec_llm = SimpleNamespace(model="exec-m")
    judge_llm = SimpleNamespace(model="judge-m")

    fp_orig = compute_evaluator_fingerprint(exec_llm, judge_llm)

    # 1. 改动 prompt template
    orig_tpl = judge_mod._PROMPT_TEMPLATE
    monkeypatch.setattr(judge_mod, "_PROMPT_TEMPLATE", orig_tpl + "\n# Extra instruction")
    fp_tpl = compute_evaluator_fingerprint(exec_llm, judge_llm)
    assert fp_orig != fp_tpl, "改动 Judge 模板必须导致指纹变化"

    # 2. 缓存失效测试
    cache = EvaluatorOutputCache()
    cache.set_bare("query-x", fp_orig, "output-orig", {"tokens": 10})
    assert cache.get_bare("query-x", fp_orig) is not None
    assert cache.get_bare("query-x", fp_tpl) is None, "模板改变后旧指纹条目无法命中"

    # 3. 改动 system prompt
    monkeypatch.setattr(judge_mod, "_PROMPT_TEMPLATE", orig_tpl)
    monkeypatch.setattr(judge_mod, "JUDGE_SYSTEM_PROMPT", "你是严格的第三方评审员。")
    fp_sys = compute_evaluator_fingerprint(exec_llm, judge_llm)
    assert fp_orig != fp_sys, "改动 Judge system prompt 必须导致指纹变化"
    assert cache.get_bare("query-x", fp_sys) is None

    # 4. 改动 dimension hints
    new_hints = dict(judge_mod.DIMENSION_HINTS)
    new_hints["task_completion"] = "新任务完成定义"
    monkeypatch.setattr(judge_mod, "DIMENSION_HINTS", new_hints)
    fp_hints = compute_evaluator_fingerprint(exec_llm, judge_llm)
    assert fp_orig != fp_hints, "改动维度提示必须导致指纹变化"
    assert cache.get_bare("query-x", fp_hints) is None


