# 2. 硬帽超限测试（超 call / 超 token / 超 deadline 分别硬停）
# ============================================================================


def test_ledger_call_cap_hard_stop():
    budget = EvolveBudget(max_calls=2)
    ledger = LLMLedger(budget=budget)
    llm = MockLLM(["r1", "r2", "r3"], token_per_call=50)
    tracked = wrap_with_ledger(llm, ledger, role="test")

    # 前 2 次调用正常
    tracked.invoke([{"role": "user", "content": "call 1"}])
    tracked.invoke([{"role": "user", "content": "call 2"}])
    assert ledger.total_calls == 2

    # 第 3 次调用必须触发硬停，抛出 BudgetExceededError
    with pytest.raises(BudgetExceededError) as exc_info:
        tracked.invoke([{"role": "user", "content": "call 3"}])

    assert exc_info.value.cap_type == "call"
    assert "CALL_LIMIT_EXCEEDED" in exc_info.value.reason
    assert exc_info.value.limit == 2


def test_ledger_token_cap_hard_stop():
    budget = EvolveBudget(max_tokens=150)
    ledger = LLMLedger(budget=budget)
    llm = MockLLM(["r1", "r2"], token_per_call=100)
    tracked = wrap_with_ledger(llm, ledger, role="test")

    # 第 1 次使用 100 token，在 150 上限内
    tracked.invoke([{"role": "user", "content": "call 1"}])
    assert ledger.total_tokens == 100

    # 第 2 次再用 100 token，累计 200 > 150，必须触发硬停
    with pytest.raises(BudgetExceededError) as exc_info:
        tracked.invoke([{"role": "user", "content": "call 2"}])

    assert exc_info.value.cap_type == "token"
    assert "TOKEN_LIMIT_EXCEEDED" in exc_info.value.reason
    assert exc_info.value.limit == 150


def test_ledger_deadline_hard_stop():
    budget = EvolveBudget(deadline_seconds=0.04)
    ledger = LLMLedger(budget=budget)
    llm = MockLLM(["r1", "r2"], token_per_call=50)
    tracked = wrap_with_ledger(llm, ledger, role="test")

    # 首次调用在 deadline 内
    tracked.invoke([{"role": "user", "content": "call 1"}])

    # 等待超过 deadline
    time.sleep(0.06)

    # 再次调用必须由于超时硬停
    with pytest.raises(BudgetExceededError) as exc_info:
        tracked.invoke([{"role": "user", "content": "call 2"}])

    assert exc_info.value.cap_type == "deadline"
    assert "DEADLINE_EXCEEDED" in exc_info.value.reason


