        computed_level="L1",
    )
    old_res = EvalResult(
        release_id="r", structure_score={}, effect_score={},
        objective_metrics={}, p0_pass=True, valid=True,
        case_verdicts=[], case_outputs=[],
    )

    res, verdict = _validate_patch(evaluator, reg, "explain_regex", patch, old_res, "repair_set")
    assert verdict.decision == "PASS"
    # 验证共享 output_cache 被 temp_eval 复用，命中数增加
    assert cache.hits >= len(p0_cases), f"temp_eval 必须复用共享 output_cache (当前命中 {cache.hits})"


