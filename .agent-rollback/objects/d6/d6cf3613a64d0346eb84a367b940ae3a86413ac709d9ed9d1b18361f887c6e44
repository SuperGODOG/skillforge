def test_evolver_patch_validation_real_judge_budget_hard_stop(tmp_path: Path):
    """真实 Judge 路径超限：Judge compare_detailed 触发 BudgetExceededError，
    验证硬停不吞为 INVALID，外层 patch 归档为 DECLINED 并停止后续候选。"""
    import shutil
    from skillforge.evolver import _validate_patch

    repo_root = Path(__file__).resolve().parent.parent
    shutil.copytree(repo_root / "skills", tmp_path / "skills")
    shutil.copytree(repo_root / "evaluation_sets", tmp_path / "evaluation_sets")

    reg = SkillRegistry(db_path=tmp_path / "t.db", skills_dir=tmp_path / "skills", repo_root=tmp_path)
    reg.load_skills_from_dir()

    old_md = (tmp_path / "skills" / "explain_regex" / "SKILL.md").read_text(encoding="utf-8")
    patch1_md = old_md.replace("version: 1.0.0", "version: 1.0.1").replace(
        "从原理层面讲解正则表达式", "从底层原理层面深入讲解正则表达式 (v1)"
    )
    patch2_md = old_md.replace("version: 1.0.0", "version: 1.0.1").replace(
        "从原理层面讲解正则表达式", "从底层原理层面深入讲解正则表达式 (v2)"
    )

    # 4 calls budget:
    # Call 1: root cause analysis
    # Call 2: patch generation
    # Call 3: bare run in patch 1 validation
    # Call 4: skill run in patch 1 validation
    # Call 5: Judge invoke -> raises BudgetExceededError
    budget = EvolveBudget(max_calls=4)
    ledger = LLMLedger(budget=budget)

    class ExecLLM:
        def __init__(self):
            self.model = "exec-m"
        def invoke(self, messages, **kw):
            return SimpleNamespace(content="answer", usage={"total_tokens": 10})

    class JudgeLLM:
        def __init__(self):
            self.model = "judge-m"
        def invoke(self, messages, **kw):
            return SimpleNamespace(
                content='{"verdict":"tied","reason_codes":["EVIDENCE_SUFFICIENT"],"evidence_summary":"ok"}',
                usage={"total_tokens": 10},
            )

    evaluator = SkillEvaluator(
        registry=reg,
        llm=ExecLLM(),
        judge_llm=JudgeLLM(),
        output_cache=EvaluatorOutputCache(),
    )
    # Baseline eval returns failure sample without calling LLM:
    evaluator.evaluate_skill = lambda *a, **kw: EvalResult(
        release_id="r", structure_score={}, effect_score={},
        objective_metrics={}, p0_pass=True, valid=True,
        case_verdicts=[{"case_id": "er_d01", "task_completion": "B_better"}],
        case_outputs=[{"case_id": "er_d01", "query": "q", "output_skill": "s", "output_baseline": "b"}],
    )

    class EvolverLLM:
        def __init__(self):
            self.model = "evolver-m"
            self.calls = []
        def invoke(self, messages, **kw):
            self.calls.append(messages)
            if len(self.calls) == 1:
                return SimpleNamespace(
                    content='{"trigger_inaccurate": {"prob": 0.8, "why": "err"}}',
                    usage={"total_tokens": 10},
                )
            return SimpleNamespace(
                content=json.dumps([
                    {"level": "L2", "rationale": "p1", "new_skill_md": patch1_md},
