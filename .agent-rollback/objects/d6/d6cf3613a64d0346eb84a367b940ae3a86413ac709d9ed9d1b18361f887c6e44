def test_l1_metadata_patch_shares_output_cache(tmp_path: Path):
    """验证 evolver.py 的 L1 metadata 分支向 SkillEvaluator 传递共享 output_cache，
    消除基线漂移并命中前置输出缓存。"""
    import shutil
    from skillforge.evolver import _validate_patch
    from skillforge.evaluator.p0_gate import load_p0_cases

    repo_root = Path(__file__).resolve().parent.parent
    shutil.copytree(repo_root / "skills", tmp_path / "skills")
    shutil.copytree(repo_root / "evaluation_sets", tmp_path / "evaluation_sets")

    reg = SkillRegistry(db_path=tmp_path / "t.db", skills_dir=tmp_path / "skills", repo_root=tmp_path)
    reg.load_skills_from_dir()

    cache = EvaluatorOutputCache()

    class ExecLLM:
        def __init__(self):
            self.model = "exec-m"
            self.calls = []
        def invoke(self, messages, **kw):
            self.calls.append(messages)
            return SimpleNamespace(content="bare answer", usage={"total_tokens": 10})

