def test_evolver_patch_validation_budget_exceeded_declines_and_halts(tmp_path: Path):
    reg = SkillRegistry(db_path=tmp_path / "t.db", skills_dir=tmp_path / "skills", repo_root=tmp_path)
    old_md = "---\nname: test_skill\nversion: 1.0.0\ndescription: X\nuse_when: Y\ntrigger:\n  keywords: [a]\n---\n\n## Overview\n..."
    (tmp_path / "skills" / "test_skill").mkdir(parents=True)
    (tmp_path / "skills" / "test_skill" / "SKILL.md").write_text(old_md, encoding="utf-8")
    reg.load_skills_from_dir()

    patch1 = Patch(
        skill_name="test_skill",
        level="L1",
        diff=old_md.replace("version: 1.0.0", "version: 1.0.1"),
        rationale="patch 1",
    )
    patch2 = Patch(
        skill_name="test_skill",
        level="L1",
        diff=old_md.replace("version: 1.0.0", "version: 1.0.2"),
        rationale="patch 2",
    )

    budget = EvolveBudget(max_calls=10)
    ledger = LLMLedger(budget=budget)

    # 模拟 evaluator 在验证第 1 个 patch 时触发预算超限
    call_count = 0
    def fake_validate(*args, **kwargs):
        nonlocal call_count
        call_count += 1
        raise BudgetExceededError("TOKEN_LIMIT_EXCEEDED: token usage 1200 > limit 1000", cap_type="token", limit=1000, current=1200)

    import skillforge.evolver as evolver_mod
    original_validate = evolver_mod._validate_patch
    evolver_mod._validate_patch = fake_validate

    try:
        evaluator_mock = SimpleNamespace(
            evaluate_skill=lambda *a, **kw: EvalResult(
                release_id="r", structure_score={}, effect_score={},
                objective_metrics={}, p0_pass=True, valid=True,
                case_verdicts=[{"case_id": "c1", "task_completion": "B_better"}],
                case_outputs=[{"case_id": "c1", "query": "q", "output_skill": "s", "output_baseline": "b"}],
            ),
            output_cache=EvaluatorOutputCache(),
            llm=MockLLM([]),
            judge=SimpleNamespace(llm=MockLLM([])),
        )

        evolver = SkillEvolver(
            registry=reg,
            evaluator=evaluator_mock,
            llm=MockLLM([
                '{"trigger_inaccurate": {"prob": 0.8, "why": "err"}}',  # root cause
                json.dumps([
                    {"level": "L1", "rationale": "p1", "new_skill_md": patch1.diff},
                    {"level": "L1", "rationale": "p2", "new_skill_md": patch2.diff},
                ]),  # patches
            ]),
            budget=budget,
            ledger=ledger,
        )

        outcome = evolver.evolve_full("test_skill", max_candidates=2, verbose=False)
        assert outcome.error is not None
        assert "沙箱验证预算硬帽超限" in outcome.error
        assert len(outcome.patches_declined) == 1, "第 1 个 patch 必须被归档为 DECLINED"
        assert call_count == 1, "预算超限后必须硬停，不得继续验证后续候选"
    finally:
        evolver_mod._validate_patch = original_validate


