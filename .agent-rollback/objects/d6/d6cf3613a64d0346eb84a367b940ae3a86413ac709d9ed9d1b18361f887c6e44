        def __init__(self):
            self.model = "judge-m"
        def invoke(self, messages, **kw):
            return SimpleNamespace(
                content='{"verdict":"tied","reason_codes":["EVIDENCE_SUFFICIENT"],"evidence_summary":"ok"}',
                usage={"total_tokens": 10},
            )

    exec_llm = ExecLLM()
    evaluator = SkillEvaluator(
        registry=reg,
        llm=exec_llm,
        judge_llm=JudgeLLM(),
        output_cache=cache,
    )

    # 预热缓存：先运行一次 P0 cases 的 bare queries
    p0_cases = load_p0_cases(tmp_path, "explain_regex")
    for c in p0_cases:
        evaluator._run_bare(c["query"])

    assert cache.hits == 0
    assert len(exec_llm.calls) == len(p0_cases)

    # 构造并验证 L1 补丁（仅改动 description）
    old_md = (tmp_path / "skills" / "explain_regex" / "SKILL.md").read_text(encoding="utf-8")
