"""P0-A: deterministic semantic diff and anti-downgrade policy."""
from __future__ import annotations

from pathlib import Path

import pytest

from skillforge.diff import compute_semantic_diff, split_markdown_sections
from skillforge.evolver import _publish_patch
from skillforge.models import EvalResult, Patch, RatchetVerdict


_BASE_FRONTMATTER = r"""---
name: explain_regex
version: 1.0.0
description: 讲解正则表达式的原理与匹配过程（不是帮用户写正则）
use_when: 用户想理解正则表达式的语法、匹配机制、回溯原理，或看懂别人写的正则
not_for:
  - 用户要求"写一个正则匹配 XX"（那是代码生成任务）
  - 正则性能调优（超出教学范围）
  - 特定正则库（re / regex / PCRE）的 API 差异
dependencies: []
trigger:
  keywords:
    - 正则
    - regex
    - 讲解
    - 匹配过程
    - 回溯
examples:
  - 讲一下 (a|b)*c 是怎么匹配的
  - 为什么 .* 会回溯这么慢
  - 这个正则 \d{4}-\d{2}-\d{2} 什么意思
evaluation:
  last_score: null
  last_release_id: null
---"""

_HISTORICAL_FRONTMATTER = r"""---
name: explain_regex
version: 1.0.1
description: {description}
use_when: 用户想理解正则表达式的语法、匹配机制、回溯原理，或看懂别人写的正则
not_for:
- 用户要求"写一个正则匹配 XX"（那是代码生成任务）
- 正则性能调优（超出教学范围）
- 特定正则库（re / regex / PCRE）的 API 差异
dependencies: []
trigger:
  keywords:
  - 正则
  - regex
  - 讲解
  - 匹配过程
  - 回溯
examples:
- 讲一下 (a|b)*c 是怎么匹配的
- 为什么 .* 会回溯这么慢
- 这个正则 \d{{4}}-\d{{2}}-\d{{2}} 什么意思{extra_example}
---"""

_BODY = """## Overview

从原理层面讲解正则表达式：**字符类 / 量词 / 分组 / 锚点 / 回溯**。目标是让用户读得懂、说得清，而不是写出可用的正则。

**能力边界**：只讲原理，不生产代码。

## Instructions

1. 识别用户问的是：
   - **具体某个正则的含义**（"这个 X 是什么意思"）
   - **某个概念的原理**（"回溯怎么工作"、"贪婪 vs 非贪婪"）
   - **两个用法的区别**（"?: 和 ? 有什么不同"）
2. 按识别到的类型走对应讲解模板：
   - **具体正则** → 从左往右逐字符/逐组解释，画出匹配步骤
   - **概念原理** → 一句话定义 + 一个小例子 + 一句陷阱提示
   - **区别** → 用同一个测试字符串对比两种写法的行为
3. 优先用小例子（5-15 字符的字符串）演示，别拿超长真实场景。

## Examples

**Q**：讲一下 `.*?` 是什么意思？

**A**：
> `.*?` 是 **非贪婪匹配**：`.*` 尽量少匹配。
>
> 对比：字符串 `<b>hi</b>foo`
> - `<.*>` 会匹配 `<b>hi</b>`（贪婪，能吃多少吃多少）
> - `<.*?>` 会匹配 `<b>`（非贪婪，够用即止）
>
> 陷阱：非贪婪不是"最快"，只是"最短匹配"，回溯次数不一定少。

## Constraints

- 用户说"帮我写一个正则匹配 XX"，直接告知"这是代码生成任务，我这里只讲原理；你可以让我讲你想到的写法为什么行/不行"。
- 不给出可以直接跑的正则字符串作为主结果（避免被当成正则生成器用）。
- 遇到复杂的实际正则（>100 字符），先拆解为几段再讲。"""

_BASE = f"{_BASE_FRONTMATTER}\n\n{_BODY}"
_CANDIDATE_1 = (
    _HISTORICAL_FRONTMATTER.format(
        description="讲解正则表达式的原理与匹配过程，提供完整、逐步的结构化解释（不是帮用户写正则）",
        extra_example="",
    )
    + f"\n\n{_BODY}"
)
_CANDIDATE_2 = (
    _HISTORICAL_FRONTMATTER.format(
        description="讲解正则表达式的原理与匹配过程（不是帮用户写正则）",
        extra_example=r"\n- 用例子讲解反向引用 \1 的匹配逻辑",
    )
    + f"\n\n{_BODY}"
)
_CANDIDATE_3 = (
