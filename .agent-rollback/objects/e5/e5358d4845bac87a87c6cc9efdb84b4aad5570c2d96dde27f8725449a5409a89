def test_historical_candidate_1_computed_as_l1() -> None:
    result = compute_semantic_diff(_BASE, _CANDIDATE_1, "L1")

    assert result.is_valid is True
    assert result.computed_level == "L1"
    assert result.changed_frontmatter == ["description"]
    assert result.changed_body_sections == []
    assert result.downgrade_attempt is False


