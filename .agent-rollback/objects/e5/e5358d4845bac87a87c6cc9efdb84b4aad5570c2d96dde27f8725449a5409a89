def test_downgrade_attack_blocked(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    result = compute_semantic_diff(_BASE, _CANDIDATE_3, "L1")
    called = False

    def unexpected_publish(*args, **kwargs):
        nonlocal called
        called = True
        raise AssertionError("downgrade attack reached automatic publishing")

    monkeypatch.setattr("skillforge.evolver._apply_and_publish_L1", unexpected_publish)
    patch = Patch(
        skill_name="explain_regex",
        level="L1",
        diff=_CANDIDATE_3,
        rationale="pretend this is low risk",
        computed_level=result.computed_level,
        unified_diff=result.unified_diff,
        downgrade_attempt=result.downgrade_attempt,
    )
    eval_result = EvalResult(
        release_id="candidate",
        structure_score={},
        effect_score={},
        objective_metrics={},
        p0_pass=True,
    )

    outcome = _publish_patch(
        tmp_path,
        registry=object(),
        state_machine=object(),
        skill_name="explain_regex",
        patch=patch,
        verdict=RatchetVerdict(decision="PASS"),
        new_result=eval_result,
    )

    assert result.computed_level == "L2"
    assert result.downgrade_attempt is True
    assert called is False
    assert outcome["status"] in {"REVIEW", "SUGGESTION"}


def test_invariants_name_tampered_invalid() -> None:
    candidate = _CANDIDATE_1.replace(
        "name: explain_regex", "name: explain_regex_v2", 1
    )

    result = compute_semantic_diff(_BASE, candidate, "L1")

    assert result.is_valid is False
    assert result.computed_level == "INVALID"
    assert "name 不变量被破坏" in (result.invalid_reason or "")


@pytest.mark.parametrize("version", ["2.0.0", "1.1.0", "0.9.0"])
def test_invariants_illegal_version_bump_invalid(version: str) -> None:
    candidate = _CANDIDATE_1.replace("version: 1.0.1", f"version: {version}", 1)

    result = compute_semantic_diff(_BASE, candidate, "L1")

    assert result.is_valid is False
    assert result.computed_level == "INVALID"
    assert "version" in (result.invalid_reason or "")


def test_risk_matrix_bubbles_to_highest_level() -> None:
    candidate = _CANDIDATE_1.replace("dependencies: []", "dependencies: [python]", 1)

    result = compute_semantic_diff(_BASE, candidate, "L1")

    assert result.computed_level == "L3"
    assert result.downgrade_attempt is True
    assert result.changed_frontmatter == ["dependencies", "description"]


def test_constraints_change_is_l3() -> None:
    candidate = _CANDIDATE_3.replace(
        "## Constraints\n", "## Constraints\n\n- 禁止泄露秘密。\n", 1
    )

    result = compute_semantic_diff(_BASE, candidate, "L2")

    assert result.computed_level == "L3"
    assert "Constraints" in result.changed_body_sections
    assert result.downgrade_attempt is True


def test_unknown_section_change_fails_closed_to_l2() -> None:
    candidate = _CANDIDATE_1 + "\n\n## Notes\n\nnew runtime guidance"

    result = compute_semantic_diff(_BASE, candidate, "L1")

    assert result.computed_level == "L2"
    assert result.changed_body_sections == ["Notes"]
    assert result.downgrade_attempt is True


def test_split_markdown_sections_preserves_duplicate_headings() -> None:
    sections = split_markdown_sections(
        "intro\n\n## Constraints\nfirst\n\n## Constraints\nsecond"
    )

    assert sections["__preamble__"] == "intro"
    assert sections["Constraints"] == "first"
    assert sections["Constraints#2"] == "second"
