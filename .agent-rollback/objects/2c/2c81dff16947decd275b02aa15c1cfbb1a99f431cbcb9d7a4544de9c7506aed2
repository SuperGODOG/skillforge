def test_load_p0_cases_cross_validation_rejects_unauthorized_dummy(tmp_path):
    """验证 load_p0_cases 交叉验证：内嵌 cases 包含不在 repair 集的 dummy case 时拒绝加载"""
    eval_dir = tmp_path / "evaluation_sets"
    eval_dir.mkdir(parents=True)

    # 构造合法的 repair_set.json
    repair_payload = {
        "cases": [
            {"id": "legit_p0_01", "skill": "test_skill", "query": "q", "reference": "r"}
        ]
    }
    (eval_dir / "repair_set.json").write_text(json.dumps(repair_payload, ensure_ascii=False), encoding="utf-8")

    # 构造被注入 dummy case 的 p0_cases.json
    p0_payload = {
        "cases": [
            {"id": "dummy_unauthorized_999", "skill": "test_skill", "query": "dummy", "reference": "dummy"}
        ]
    }
    (eval_dir / "p0_cases.json").write_text(json.dumps(p0_payload, ensure_ascii=False), encoding="utf-8")

    with pytest.raises(P0LoadError, match="未在 repair_set.json 中找到合法来源"):
        load_p0_cases(tmp_path, skill_name="test_skill")


def test_load_p0_cases_rejects_subset_reduction(tmp_path):
    """验证 load_p0_cases 强化交叉验证：内嵌 cases 缩减为合法 ID 子集时必须拒绝"""
    eval_dir = tmp_path / "evaluation_sets"
    eval_dir.mkdir(parents=True)

    repair_payload = {
        "cases": [
            {"id": "legit_p0_01", "skill": "test_skill", "query": "q1", "reference": "r1"},
            {"id": "legit_p0_02", "skill": "test_skill", "query": "q2", "reference": "r2"},
        ]
    }
    (eval_dir / "repair_set.json").write_text(json.dumps(repair_payload, ensure_ascii=False), encoding="utf-8")

    # p0_ids 为 2 个，但内嵌 cases 缩减为 1 个
    p0_payload = {
        "meta": {"total": 2},
        "p0_ids": ["legit_p0_01", "legit_p0_02"],
        "cases": [
            {"id": "legit_p0_01", "skill": "test_skill", "query": "q1", "reference": "r1"}
        ]
    }
    (eval_dir / "p0_cases.json").write_text(json.dumps(p0_payload, ensure_ascii=False), encoding="utf-8")

    with pytest.raises(P0LoadError, match="不一致"):
        load_p0_cases(tmp_path, skill_name="test_skill")


def test_load_p0_cases_rejects_content_tampering(tmp_path):
    """验证 load_p0_cases 全对象比对：同 ID 但 query/reference 遭到篡改时拒绝"""
    eval_dir = tmp_path / "evaluation_sets"
    eval_dir.mkdir(parents=True)

    repair_payload = {
        "cases": [
            {"id": "legit_p0_01", "skill": "test_skill", "query": "真实查询内容", "reference": "真实参考答案"}
        ]
    }
    (eval_dir / "repair_set.json").write_text(json.dumps(repair_payload, ensure_ascii=False), encoding="utf-8")

    # ID 一致，但 query 被改写为“固定回答 OK 即可”
    p0_payload = {
        "meta": {"total": 1},
        "p0_ids": ["legit_p0_01"],
        "cases": [
            {"id": "legit_p0_01", "skill": "test_skill", "query": "固定回答 OK 即可", "reference": "真实参考答案"}
        ]
    }
    (eval_dir / "p0_cases.json").write_text(json.dumps(p0_payload, ensure_ascii=False), encoding="utf-8")

    with pytest.raises(P0LoadError, match="query.*不一致"):
        load_p0_cases(tmp_path, skill_name="test_skill")


def test_mainline_l1_patch_blocked_if_baseline_has_no_p0_proof(monkeypatch, tmp_path):
    """验证终审反例 BLOCKER-01：无 P0 集基线 (old_result.p0_pass=True 但无完整证明) + L1 候选必须执行独立 P0 门，未通过 → DECLINED"""
    from skillforge.diff import compute_semantic_diff
    from skillforge.evolver import _validate_patch
    from skillforge.models import Patch, RatchetVerdict
    from skillforge.registry import SkillRegistry

    registry = SkillRegistry(
        db_path=tmp_path / "reg.db",
        skills_dir=REPO_ROOT / "skills",
        repo_root=REPO_ROOT,
    )
    registry.load_skills_from_dir()

    old_md = (REPO_ROOT / "skills" / "weather_query" / "SKILL.md").read_text(encoding="utf-8")
    new_md = old_md.replace("version: 1.0.0", "version: 1.0.1", 1).replace(
        "description: 查询指定城市的实时天气与未来 3 天预报",
        "description: 快速查询指定城市的实时天气与未来 3 天预报",
        1,
    )
    diff = compute_semantic_diff(old_md, new_md, "L1")
    patch = Patch(
        skill_name="weather_query",
        level="L1",
        diff=new_md,
        rationale="metadata tweak",
        computed_level="L1",
        unified_diff=diff.unified_diff,
        downgrade_attempt=False,
        changed_frontmatter=diff.changed_frontmatter,
        changed_body_sections=[],
    )

    monkeypatch.setattr(
        "skillforge.evolver.validate_router_patch",
        lambda *args, **kwargs: RatchetVerdict(decision="PASS"),
    )

    # 构造来自 non-P0 集的基线（p0_pass 假象为 True，但无 p0_gate_result 完整凭证）
    baseline_from_non_p0 = EvalResult(
        release_id="baseline-from-non-p0-set",
        structure_score={"schema": 15.0},
        effect_score={"task": 20.0},
        objective_metrics={},
        p0_pass=True,
        valid=True,
    )

    # 设置 evaluator 在评测时抛错或未通过 P0
    mock_evaluator = MagicMock()
    mock_evaluator.llm = MagicMock()
    mock_evaluator.judge = MagicMock()
    mock_evaluator.evaluate_skill.side_effect = RuntimeError("P0 evaluator forced failure for non-p0 test")

    result, verdict = _validate_patch(
        mock_evaluator,
        registry,
        "weather_query",
        patch,
        baseline_from_non_p0,
        "experiment_holdout",
    )
    registry.close()

    assert verdict.decision == "DECLINED"
    assert any("P0" in r or "INVALID" in r for r in verdict.reasons)


def test_mainline_l1_patch_blocked_if_baseline_p0_fails(monkeypatch, tmp_path):
    """验证主链路防线：当基线未通过 P0 门时，纯 metadata 的 L1 补丁被绝对阻断拒绝"""
    from skillforge.diff import compute_semantic_diff
    from skillforge.evolver import _validate_patch
    from skillforge.models import Patch, RatchetVerdict
    from skillforge.registry import SkillRegistry

    registry = SkillRegistry(
        db_path=tmp_path / "reg.db",
        skills_dir=REPO_ROOT / "skills",
        repo_root=REPO_ROOT,
    )
    registry.load_skills_from_dir()

    old_md = (REPO_ROOT / "skills" / "weather_query" / "SKILL.md").read_text(encoding="utf-8")
    new_md = old_md.replace("description: 查询指定城市的天气预报", "description: 快速查询指定城市天气预报")
    diff = compute_semantic_diff(old_md, new_md, "L1")
    patch = Patch(
        skill_name="weather_query",
        level="L1",
        diff=new_md,
        rationale="metadata tweak",
        computed_level="L1",
        unified_diff=diff.unified_diff,
        downgrade_attempt=False,
        changed_frontmatter=diff.changed_frontmatter,
        changed_body_sections=[],
    )

    monkeypatch.setattr(
        "skillforge.evolver.validate_router_patch",
        lambda *args, **kwargs: RatchetVerdict(decision="PASS"),
    )

    # 制造基线 P0 失败状态
    broken_old_result = EvalResult(
        release_id="baseline",
        structure_score={"schema": 15.0},
        effect_score={"task": 20.0},
        objective_metrics={},
        p0_pass=False,  # 基线 P0 失败！
        valid=True,
    )

    mock_evaluator = MagicMock()
    result, verdict = _validate_patch(
        mock_evaluator,
        registry,
        "weather_query",
        patch,
        broken_old_result,
        "repair_set",
    )
    registry.close()

    assert verdict.decision == "DECLINED"
    assert any("P0" in r or "fail-closed" in r for r in verdict.reasons)


