    """验证主链路防线：行为补丁中若 P0 用例未通过，_validate_patch 绝对阻断并拒绝发布"""
    from skillforge.diff import compute_semantic_diff
    from skillforge.evolver import _validate_patch
    from skillforge.models import Patch
    from skillforge.registry import SkillRegistry

    registry = SkillRegistry(
        db_path=tmp_path / "reg.db",
        skills_dir=REPO_ROOT / "skills",
        repo_root=REPO_ROOT,
    )
    registry.load_skills_from_dir()

    old_md = (REPO_ROOT / "skills" / "weather_query" / "SKILL.md").read_text(encoding="utf-8")
    new_md = old_md + "\n# Extra instruction\n"
    diff = compute_semantic_diff(old_md, new_md, "L2")
    patch = Patch(
        skill_name="weather_query",
        level="L2",
        diff=new_md,
        rationale="body tweak",
        computed_level="L2",
        unified_diff=diff.unified_diff,
        downgrade_attempt=False,
        changed_frontmatter=[],
        changed_body_sections=["Overview"],
    )

    class FailingP0SkillEvaluator:
        def __init__(self, registry, llm, judge_llm):
            pass

        def _load_cases(self, eval_set, skill_name):
            return [{"id": "wq_d01", "skill": skill_name, "query": "q"}]

        def evaluate_skill(self, *args, **kwargs):
            # 模拟 P0 用例失败 (B_better)
            return EvalResult(
                release_id="candidate",
                structure_score={"schema": 15.0},
                effect_score={"task": 20.0},
                objective_metrics={},
                p0_pass=False,
                valid=True,
                case_verdicts=[
                    {"case_id": "wq_d01", "task_completion": "B_better", "robustness": "tied", "readability": "tied"},
                    {"case_id": "wq_d05", "task_completion": "tied", "robustness": "tied", "readability": "tied"},
                    {"case_id": "wq_d07", "task_completion": "tied", "robustness": "tied", "readability": "tied"},
                    {"case_id": "wq_d10", "task_completion": "tied", "robustness": "tied", "readability": "tied"},
                ],
            )

    monkeypatch.setattr("skillforge.evaluator.SkillEvaluator", FailingP0SkillEvaluator)

    old_result = EvalResult(
        release_id="baseline",
        structure_score={"schema": 15.0},
        effect_score={"task": 25.0},
        objective_metrics={},
        p0_pass=True,
        valid=True,
    )

    mock_evaluator = MagicMock()
    result, verdict = _validate_patch(
        mock_evaluator,
        registry,
        "weather_query",
        patch,
        old_result,
        "repair_set",
    )
    registry.close()

    assert verdict.decision == "DECLINED"
    assert any("P0" in r for r in verdict.reasons)
    assert result.p0_pass is False

