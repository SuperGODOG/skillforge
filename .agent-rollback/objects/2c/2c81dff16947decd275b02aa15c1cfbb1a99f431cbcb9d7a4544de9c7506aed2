def test_evaluate_p0_gate_missing_or_invalid_dimensions():
    """验证白名单化拦截：缺失维度或非法判定值必须判为 INVALID (fail-closed)"""
    mock_evaluator = MagicMock()
    mock_eval_res = MagicMock()
    mock_eval_res.valid = True
    mock_eval_res.invalid_reasons = []

    custom_cases = [
        {"id": "wq_d01", "skill": "weather_query", "query": "q1", "reference": "r1"},
    ]

    # 1. 缺失 task_completion 维度
    mock_eval_res.case_verdicts = [
        {"case_id": "wq_d01", "robustness": "tied", "readability": "tied"},
    ]
    mock_evaluator.evaluate_skill.return_value = mock_eval_res
    res = evaluate_p0_gate(mock_evaluator, "weather_query", p0_cases=custom_cases)
    assert res.valid is False
    assert any("task_completion" in r for r in res.invalid_reasons)

    # 2. task_completion 值为 None
    mock_eval_res.case_verdicts = [
        {"case_id": "wq_d01", "task_completion": None, "robustness": "tied", "readability": "tied"},
    ]
    res = evaluate_p0_gate(mock_evaluator, "weather_query", p0_cases=custom_cases)
    assert res.valid is False
    assert any("task_completion" in r for r in res.invalid_reasons)

    # 3. 缺失 robustness 或 readability 维度
    mock_eval_res.case_verdicts = [
        {"case_id": "wq_d01", "task_completion": "A_better", "readability": "tied"},
    ]
    res = evaluate_p0_gate(mock_evaluator, "weather_query", p0_cases=custom_cases)
    assert res.valid is False
    assert any("robustness" in r for r in res.invalid_reasons)

    # 4. 非法判定值 (如 "UNKNOWN")
    mock_eval_res.case_verdicts = [
        {"case_id": "wq_d01", "task_completion": "UNKNOWN", "robustness": "tied", "readability": "tied"},
    ]
    res = evaluate_p0_gate(mock_evaluator, "weather_query", p0_cases=custom_cases)
    assert res.valid is False
    assert any("UNKNOWN" in r for r in res.invalid_reasons)


