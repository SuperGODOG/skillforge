def format_execution_behavior(data: Optional[dict[str, Any] | list[Any] | str] = None) -> str:
    """格式化执行行为轨迹结构化文本。若为空则输出正常轨迹占位。"""
    if not data:
        return "（未记录到执行层异常，系统处于正常评估执行状态）"
    if isinstance(data, str):
        return data.strip()
    if isinstance(data, list):
        # 兼容 list[ToolCallProvenance] 或 list[dict]
        def _get_status(x):
            return x.get("output_status", "") if isinstance(x, dict) else getattr(x, "output_status", "")
        def _get_succ(x):
            return x.get("tool_success", True) if isinstance(x, dict) else getattr(x, "tool_success", True)
        def _get_auth(x):
            return x.get("authenticity_pass", True) if isinstance(x, dict) else getattr(x, "authenticity_pass", True)

        has_circuit = any(_get_status(x) == "CIRCUIT_OPEN" for x in data)
        has_error = any(_get_status(x) == "ERROR" or not _get_succ(x) or not _get_auth(x) for x in data)
        has_dep = has_circuit or has_error
        fail_type = "CIRCUIT_OPEN" if has_circuit else ("DEPENDENCY_ERROR" if has_error else "UNKNOWN")

        data = {
            "failed_phase": "tool_execution" if has_dep else "none",
            "failure_type": fail_type,
            "is_dependency_failure": has_dep,
            "tool_provenances": [p.__dict__ if hasattr(p, "__dict__") else p for p in data],
        }

    failed_phase = str(data.get("failed_phase") or "none")
    failure_type = str(data.get("failure_type") or "NONE")
    is_dep = bool(data.get("is_dependency_failure", False))
    # 启发式检查
    if failure_type in ("DEPENDENCY_ERROR", "LLM_ERROR", "NETWORK_ERROR", "TOOL_NOT_FOUND", "CIRCUIT_OPEN"):
        is_dep = True
    error_message = str(data.get("error_message") or "无显式错误抛出")
    validation_channels = json.dumps(data.get("validation_channels") or [], ensure_ascii=False)

    provenances = data.get("tool_provenances") or []
    prov_count = len(provenances)
    prov_lines = []
    if prov_count > 0:
        for p in provenances[:5]:
            if isinstance(p, dict):
                tool = p.get("tool_name", "unknown")
                status = p.get("output_status", "UNKNOWN")
                succ = p.get("tool_success", True)
                summary = p.get("output_summary", "")
                prov_lines.append(f"  * 工具 `{tool}` 状态={status}, 成功={succ}, 摘要={summary[:60]}")
            else:
                prov_lines.append(f"  * 凭证: {str(p)[:60]}")
    prov_details = "\n".join(prov_lines) if prov_lines else "  * （无特定工具异常记录）"

    return EXECUTION_BEHAVIOR_TEMPLATE.format(
        failed_phase=failed_phase,
        failure_type=failure_type,
        is_dependency_failure=str(is_dep).lower(),
        error_message=error_message,
        validation_channels=validation_channels,
        provenance_count=prov_count,
        provenance_details=prov_details,
    )


# =============== 3. 相关 Body 段提取与格式化 ===============


def extract_relevant_body_sections(
    body: str,
    target_sections: Optional[list[str]] = None,
) -> dict[str, str]:
    """提取 Body 中相关分段内容（与 P1-E baseline_stats 呼应）。

    若未指定 target_sections，则提取所有非空的四段式标准段落；
    若指定 target_sections，则针对目标段落进行筛选归一。
    """
    sections = split_markdown_sections(body)
    normalized: dict[str, str] = {}
    for name, content in sections.items():
        cname = canonical_section_name(name)
        if cname not in normalized or len(content) > len(normalized[cname]):
            normalized[cname] = content

    if target_sections:
        target_canon = {canonical_section_name(t) for t in target_sections}
        return {k: v for k, v in normalized.items() if k in target_canon}

    return {k: v for k, v in normalized.items() if v.strip()}


def format_body_sections(sections_data: Optional[dict[str, str] | str], body: str = "") -> str:
    """将相关 Body 段格式化为结构化文本展示。"""
    if isinstance(sections_data, str):
        return sections_data.strip()
    if sections_data is None:
        sections_data = extract_relevant_body_sections(body)

    if not sections_data:
        return "（未指定独立相关 Body 段，采用全局 Body 内容）"

    stats = compute_body_section_stats(body) if body else {}
    lines = []
    for sec_name, content in sections_data.items():
        char_cnt = len(content.strip())
        lines.append(f"### Section: {sec_name} ({char_cnt} 字符)")
        lines.append("```markdown")
        lines.append(content.strip() if content.strip() else "（段落为空）")
        lines.append("```")
    return "\n".join(lines)


def validate_payload_against_schema(instance: Any, schema: dict[str, Any]) -> tuple[bool, list[str]]:
    """轻量级 JSON Schema (Draft-07) 实例校验器，无需外部依赖。"""
    errors: list[str] = []

    def _validate_node(val: Any, sch: dict[str, Any], path: str = "$") -> None:
        expected_type = sch.get("type")
        if expected_type == "object":
            if not isinstance(val, dict):
                errors.append(f"{path}: expected object, got {type(val).__name__}")
                return
            for req in sch.get("required", []):
                if req not in val or val[req] is None:
                    errors.append(f"{path}: missing required field '{req}'")
            props = sch.get("properties", {})
            for k, sub_val in val.items():
                if k in props and sub_val is not None:
                    _validate_node(sub_val, props[k], f"{path}.{k}")
        elif expected_type == "string":
            if not isinstance(val, str):
                errors.append(f"{path}: expected string, got {type(val).__name__}")
                return
            if "enum" in sch and val not in sch["enum"]:
                errors.append(f"{path}: '{val}' not in enum {sch['enum']}")
        elif expected_type == "boolean":
            if not isinstance(val, bool):
                errors.append(f"{path}: expected boolean, got {type(val).__name__}")
        elif expected_type == "array":
            if not isinstance(val, list):
                errors.append(f"{path}: expected array, got {type(val).__name__}")
                return
            item_sch = sch.get("items")
            if item_sch:
                for idx, item in enumerate(val):
                    _validate_node(item, item_sch, f"{path}[{idx}]")
        elif expected_type in ("number", "integer"):
            if not isinstance(val, (int, float)) or (expected_type == "integer" and not isinstance(val, int)):
                errors.append(f"{path}: expected {expected_type}, got {type(val).__name__}")

    _validate_node(instance, schema)
    return len(errors) == 0, errors
