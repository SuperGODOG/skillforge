    if isinstance(data, str):
        return data.strip()

    hit_layer = str(data.get("hit_layer") or "unknown")
    declared_level = str(data.get("declared_level") or "unknown")
    computed_level = str(data.get("computed_level") or "unknown")
    verdict = str(data.get("verdict") or "N/A")
    trigger_keywords = json.dumps(data.get("trigger_keywords") or [], ensure_ascii=False)
    matched_keywords = json.dumps(data.get("matched_keywords") or [], ensure_ascii=False)
    use_when = str(data.get("use_when") or "N/A")
    not_for = json.dumps(data.get("not_for") or [], ensure_ascii=False)
    routing_notes = str(data.get("routing_notes") or "无额外路由判定信息")

    return ROUTING_METADATA_TEMPLATE.format(
        hit_layer=hit_layer,
        declared_level=declared_level,
        computed_level=computed_level,
        verdict=verdict,
        trigger_keywords=trigger_keywords,
        matched_keywords=matched_keywords,
        use_when=use_when,
        not_for=not_for,
        routing_notes=routing_notes,
    )


