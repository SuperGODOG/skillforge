class PromptFragment(dict):
    """Prompt 片段契约对象，同时支持属性访问与字典访问，便于测试与组装。"""

    def __init__(
        self,
        name: str,
        description: str,
        schema: dict[str, Any],
        template: str,
    ) -> None:
        super().__init__(
            name=name,
            description=description,
            schema=schema,
            template=template,
        )
        self.name = name
        self.description = description
        self.schema = schema
        self.template = template

    def __getattr__(self, item: str) -> Any:
        try:
            return self[item]
        except KeyError:
            raise AttributeError(f"'{self.__class__.__name__}' object has no attribute '{item}'")


